{
    "name": "imaginawp/imagina-menu",
    "description": "Navegación móvil tipo app para WordPress y WooCommerce: panel con submenús deslizantes, barra inferior y buscador, ultraligera.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Imagina WP"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ImaginaMenu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ImaginaMenu\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "bench": "php -d opcache.enable_cli=1 tests/Performance/render-benchmark.php"
    }
}
