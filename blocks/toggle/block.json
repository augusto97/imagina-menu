{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "imagina-menu/toggle",
	"title": "Botón de Imagina Menu",
	"category": "theme",
	"icon": "menu",
	"description": "Abre el panel de Imagina Menu (en el celular o, como el «☰ Todo» de Amazon, en la cabecera de escritorio). No carga JavaScript en el sitio: usa la Popover API.",
	"keywords": [
		"menú",
		"hamburguesa",
		"móvil",
		"escritorio",
		"imagina"
	],
	"textdomain": "imagina-menu",
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "string",
			"default": ""
		},
		"only": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": {
			"text": true
		},
		"spacing": {
			"padding": true
		}
	},
	"editorScript": "file:./index.js"
}
